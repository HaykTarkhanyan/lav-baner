---
import { Font } from "astro:assets";
import "../styles/global.css";
import { SITE, UI, absoluteUrl, pathFor } from "../i18n";
import type { Lang } from "../taxonomy";

interface Props {
  lang: Lang;
  // Set on topic pages: the topic key (for URLs) plus page-specific title and description.
  topic?: string;
  title?: string;
  description?: string;
  // Items for the JSON-LD ItemList (name + main URL), so search engines see the list.
  listItems?: { name: string; url: string }[];
}
const { lang, topic, listItems = [] } = Astro.props;
const t = UI[lang];
const title = Astro.props.title ?? t.title;
const description = Astro.props.description ?? t.metaDescription;
const canonical = absoluteUrl(pathFor(lang, topic));
const ogImage = absoluteUrl(`${SITE.base}/og.png`);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonical,
  inLanguage: lang,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: listItems.length,
    itemListElement: listItems.map((it, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: it.name,
      url: it.url,
    })),
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(pathFor("en", topic))} />
    <link rel="alternate" hreflang="hy" href={absoluteUrl(pathFor("hy", topic))} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(pathFor("en", topic))} />
    <link rel="icon" href={`${SITE.base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${SITE.base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#F7EEE9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171B" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lav baner" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "hy_AM"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "hy_AM" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-body" preload={[{ weight: "400", subset: lang === "hy" ? "armenian" : "latin" }]} />
    <Font cssVariable="--font-mark" preload />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
