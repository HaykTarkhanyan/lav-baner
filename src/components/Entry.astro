---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { LINK_KEYS, LINK_TYPES, SECTIONS, TOPICS, type Lang, type LinkKey } from "../taxonomy";
import { UI, pathFor } from "../i18n";

interface Props {
  item: CollectionEntry<"items">["data"];
  lang: Lang;
}
const { item, lang } = Astro.props;
const t = UI[lang];

// Logos live in src/assets/logos/<id>.(webp|png|jpg); an entry without one shows its section emoji.
const logos = import.meta.glob<{ default: ImageMetadata }>("../assets/logos/*.{webp,png,jpg,jpeg}", { eager: true });
const logo = Object.entries(logos).find(([path]) => path.split("/").pop()!.replace(/\.\w+$/, "") === item.id)?.[1]
  .default;
const isFilm = item.section === "film";

// Links in the fixed taxonomy order; the first one is the link on the name.
const links = LINK_KEYS.filter((k) => item.links[k]).map((k) => ({
  type: k as LinkKey,
  href: item.links[k] as string,
  label: LINK_TYPES[k][lang],
}));
const primary = links[0];

const isSaying = item.section === "sayings";
// In Armenian mode the Armenian name leads; in English mode the Latin one does.
const mainName = lang === "hy" && item.name_hy ? item.name_hy : item.name;
const altName = lang === "hy" ? (item.name_hy ? item.name : undefined) : item.name_hy;
const description = item.description?.[lang];

// Everything a visitor might type into search, in both languages.
const searchText = [
  item.name,
  item.name_hy,
  item.description?.en,
  item.description?.hy,
  item.text,
  item.translation,
  item.meaning,
  ...item.topics.flatMap((k) => [TOPICS[k].en, TOPICS[k].hy]),
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<article
  class:list={["entry", { "entry--saying": isSaying }]}
  data-section={item.section}
  data-armenian={item.armenian ? "1" : "0"}
  data-topics={item.topics.join(" ")}
  data-search={searchText}
>
  {
    isSaying ? (
      <>
        <p class="saying" lang="hy">
          {item.text}
        </p>
        {lang === "en" && item.translation && <p class="saying-literal">“{item.translation}”</p>}
        {lang === "en" && item.meaning && <p class="saying-meaning">{item.meaning}</p>}
      </>
    ) : (
      <>
        <div class="entry-head">
          {logo ? (
            <Image
              src={logo}
              alt=""
              width={isFilm ? 48 : 44}
              densities={[1, 2]}
              class:list={["logo", { "logo--poster": isFilm }]}
            />
          ) : (
            <span class:list={["logo", "logo--emoji", { "logo--poster": isFilm }]} aria-hidden="true">
              {SECTIONS[item.section].emoji}
            </span>
          )}
          <div>
            <h3 class="entry-name">
              {item.armenian && (
                <span class="flag" role="img" aria-label={t.armenianMark} title={t.armenianMark} />
              )}
              <a href={primary.href} rel="noopener" lang={lang === "hy" && item.name_hy ? "hy" : undefined}>
                {mainName}
              </a>
            </h3>
            {altName && (
              <p class="entry-alt" lang={lang === "en" ? "hy" : undefined}>
                {altName}
              </p>
            )}
          </div>
        </div>
        <p class="entry-desc">{description}</p>
      </>
    )
  }
  {
    (item.topics.length > 0 || links.length > 0) && (
      <div class="entry-foot">
        {item.topics.length > 0 && (
          <ul class="entry-topics">
            {item.topics.map((k) => (
              <li>
                <a href={pathFor(lang, k)}>{TOPICS[k][lang]}</a>
              </li>
            ))}
          </ul>
        )}
        {links.length > 0 && (
          <ul class="entry-links">
            {links.map((l) => (
              <li>
                <a href={l.href} rel="noopener" aria-label={`${mainName ?? ""} ${l.label}`.trim()} title={l.label}>
                  <svg width="18" height="18" aria-hidden="true" focusable="false">
                    <use href={`#i-${l.type}`} />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }
</article>
