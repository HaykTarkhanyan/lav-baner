---
// All link-type icons, defined once per page as <symbol>s; entries reference them
// with <use href="#i-youtube">. Brand marks come from simple-icons at build time.
import {
  siApplepodcasts,
  siAppstore,
  siFacebook,
  siGithub,
  siGoogleplay,
  siImdb,
  siInstagram,
  siNotion,
  siPatreon,
  siReddit,
  siSpotify,
  siTelegram,
  siTiktok,
  siWikipedia,
  siX,
  siYoutube,
} from "simple-icons";
import type { LinkKey } from "../taxonomy";

interface Props {
  // Only link types that some entry uses get a symbol.
  used: Set<string>;
}
const { used } = Astro.props;

const brand: [LinkKey, string][] = [
  ["youtube", siYoutube.path],
  ["wikipedia", siWikipedia.path],
  ["imdb", siImdb.path],
  ["telegram", siTelegram.path],
  ["instagram", siInstagram.path],
  ["facebook", siFacebook.path],
  ["x", siX.path],
  ["tiktok", siTiktok.path],
  ["patreon", siPatreon.path],
  ["spotify", siSpotify.path],
  ["apple_podcasts", siApplepodcasts.path],
  ["github", siGithub.path],
  ["notion", siNotion.path],
  ["reddit", siReddit.path],
  ["app_store", siAppstore.path],
  ["google_play", siGoogleplay.path],
];
const line = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.8",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  {
    brand.filter(([key]) => used.has(key)).map(([key, d]) => (
      <symbol id={`i-${key}`} viewBox="0 0 24 24">
        <path d={d} fill="currentColor" />
      </symbol>
    ))
  }
  {used.has("website") && (<symbol id="i-website" viewBox="0 0 24 24">
    <g {...line}>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path>
    </g>
  </symbol>)}
  {used.has("map") && (<symbol id="i-map" viewBox="0 0 24 24">
    <g {...line}>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"></path>
      <circle cx="12" cy="10" r="2.4"></circle>
    </g>
  </symbol>)}
  {used.has("pdf") && (<symbol id="i-pdf" viewBox="0 0 24 24">
    <g {...line}>
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
      <path d="M14 3v5h5M9 13h6M9 17h4"></path>
    </g>
  </symbol>)}
  {used.has("sheet") && (<symbol id="i-sheet" viewBox="0 0 24 24">
    <g {...line}>
      <rect x="4" y="4" width="16" height="16" rx="2"></rect>
      <path d="M4 10h16M4 15h16M10 4v16"></path>
    </g>
  </symbol>)}
  {used.has("linkedin") && (<symbol id="i-linkedin" viewBox="0 0 24 24">
    <g {...line}>
      <rect x="3.5" y="3.5" width="17" height="17" rx="3"></rect>
      <path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6V16"></path>
    </g>
  </symbol>)}
</svg>
